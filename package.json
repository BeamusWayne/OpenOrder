{
  "name": "openorder",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:migrate": "pnpm --filter @openorder/db migrate",
    "db:seed": "pnpm --filter @openorder/simulator seed",
    "test:load": "k6 run infra/k6/checkout.js"
  }
}
