{
  "name": "openorder",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "playwright": "^1.51.1"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:migrate": "pnpm --filter @openorder/db migrate",
    "db:seed": "pnpm --filter @openorder/simulator seed",
    "test:load": "k6 run infra/k6/checkout.js",
    "test:load:node": "pnpm --filter @openorder/api exec tsx ../../infra/k6/checkout.node.ts",
    "test:e2e": "node scripts/verify-order-flow.mjs",
    "test:e2e:chrome": "HEADLESS=0 node scripts/verify-order-flow.mjs",
    "dev:mock": "pnpm --filter @openorder/llm-mock dev",
    "dev:api": "pnpm --filter @openorder/api dev",
    "dev:web": "pnpm --filter @openorder/web dev"
  }
}
